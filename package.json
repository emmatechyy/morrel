{
  "name": "morrel",
  "private": true,
  "version": "0.1.0",
  "description": "Memory store for coding agents where every memory is gated by a passing Kane CLI flow.",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/core --filter ./packages/cli run build && pnpm --filter @morrel/web run build",
    "build:core": "pnpm --filter @morrel/core run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm --filter @morrel/core run test",
    "dev": "pnpm --filter @morrel/web run dev",
    "seed": "node scripts/seed.mjs",
    "morrel": "node packages/cli/dist/index.js"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp",
      "@tailwindcss/oxide",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "playwright-core": "^1.65.1"
  }
}
